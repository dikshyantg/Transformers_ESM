@dataclass(frozen=True)
class ClassConfig:
    """Configuration for one classification category.

    Attributes:
        embedding_dirs: Directories containing saved embedding files.
        category_id: Integer class label used by the classifier.
        max_count_per_dir: Maximum number of samples to load from each directory.
    """

    embedding_dirs: Sequence[str]
    category_id: int
    max_count_per_dir: int = 50


class ChlDataset(Dataset):
    """Simple torch dataset for padded embeddings and class labels."""

    def __init__(self, sequences: torch.Tensor, labels: Sequence[int]) -> None:
        self.sequences = sequences
        self.labels = list(labels)

    def __len__(self) -> int:
        return len(self.sequences)

    def __getitem__(self, idx: int) -> Tuple[torch.Tensor, int]:
        return self.sequences[idx], self.labels[idx]


def _is_valid_embedding_record(embs: dict, emb_layer: int, max_seq_len: int) -> bool:
    """Check whether an embedding record passes filtering rules."""
    label = str(embs.get("label", ""))
    if "hypothetical" in label or "proteobact" in label:
        return False

    representations = embs.get("representations", {})
    if emb_layer not in representations:
        return False

    return len(representations[emb_layer]) < max_seq_len


def _iter_embedding_files(directories: Sequence[str]) -> Iterable[Path]:
    """Yield all files from a sequence of directories."""
    for directory in directories:
        for name in os.listdir(directory):
            path = Path(directory) / name
            if path.is_file():
                yield path


def load_labels(
    embedding_dirs: Sequence[str], emb_layer: int, max_count_per_dir: int, max_seq_len: int = 480
) -> List[str]:
    """Load label strings from embedding files with filtering."""
    labels: List[str] = []

    for directory in embedding_dirs:
        count = 0
        for path in _iter_embedding_files([directory]):
            embs = torch.load(path)
            if _is_valid_embedding_record(embs, emb_layer, max_seq_len):
                labels.append(embs["label"])
                count += 1
                if count >= max_count_per_dir:
                    break
    return labels


def load_embeddings(
    embedding_dirs: Sequence[str],
    emb_layer: int,
    max_count_per_dir: int,
    max_seq_len: int = 480,
) -> List[Tuple[torch.Tensor, str]]:
    """Load filtered embedding tensors and raw labels.

    Returns:
        A flat list of ``(embedding_tensor, label_text)`` pairs.
    """
    loaded: List[Tuple[torch.Tensor, str]] = []

    for directory in embedding_dirs:
        count = 0
        for path in _iter_embedding_files([directory]):
            embs = torch.load(path)
            if _is_valid_embedding_record(embs, emb_layer, max_seq_len):
                loaded.append((embs["representations"][emb_layer], embs["label"]))
                count += 1
                if count >= max_count_per_dir:
                    break
    return loaded


def sample_class_data(
    examples: Sequence[Tuple[torch.Tensor, str]], category_id: int, slice_size: int
) -> List[Tuple[torch.Tensor, int]]:
    """Randomly sample examples and convert them to integer class labels."""
    n = min(len(examples), slice_size)
    indices = random.sample(range(len(examples)), n)
    return [(examples[i][0], category_id) for i in indices]


def pad_or_truncate_batch(sequences: Sequence[torch.Tensor], max_length: int = 450) -> torch.Tensor:
    """Pad or truncate each sequence to a fixed length and stack them."""
    processed: List[torch.Tensor] = []
    for seq in sequences:
        seq_len = seq.size(0)
        if seq_len < max_length:
            padded_seq = F.pad(seq, (0, 0, 0, max_length - seq_len), value=0)
        else:
            padded_seq = seq[:max_length]
        processed.append(padded_seq)
    return torch.stack(processed, dim=0)


def build_train_dataset(
    class_configs: Sequence[ClassConfig],
    emb_layer: int,
    slice_size: int = 10,
) -> Tuple[ChlDataset, torch.Tensor, List[int]]:
    """Build a sampled dataset and return train split plus full sampled data."""
    sampled: List[Tuple[torch.Tensor, int]] = []

    for config in class_configs:
        examples = load_embeddings(config.embedding_dirs, emb_layer, config.max_count_per_dir)
        sampled.extend(sample_class_data(examples, config.category_id, slice_size))

    sequences = [item[0] for item in sampled]
    labels = [item[1] for item in sampled]
    input_data = pad_or_truncate_batch(sequences)

    x_train, _x_test, y_train, _y_test = train_test_split(
        input_data, labels, test_size=0.2, random_state=42
    )
    return ChlDataset(x_train, y_train), input_data, labels


def visualize_attention_batch(
    model: torch.nn.Module,
    dataloader,
    fontsize: int = 15,
) -> None:
    """Visualize three attention heads for the first batch from a dataloader."""
    for batch_idx, (batch_sequences, _batch_labels) in enumerate(dataloader):
        if batch_idx >= 1:
            break

        print(f"processing batch {batch_idx}")

        with torch.no_grad():
            output, alpha1, alpha2, alpha3 = model(batch_sequences)
            _, predicted = torch.max(output, 1)

            batch_size, seq_len, _ = batch_sequences.shape
            alpha1 = alpha1.reshape(batch_size, seq_len)
            alpha2 = alpha2.reshape(batch_size, seq_len)
            alpha3 = alpha3.reshape(batch_size, seq_len)

            fig, axs = plt.subplots(1, 3, figsize=(20, 7))
            for i, alpha in enumerate([alpha1, alpha2, alpha3]):
                sns.heatmap(alpha.detach().cpu().numpy(), cmap="YlGnBu", ax=axs[i])
                axs[i].set_yticks(np.arange(len(predicted)) + 0.5)
                axs[i].set_yticklabels(predicted.tolist(), fontsize=fontsize)
                axs[i].set_xlabel("Input sequence", fontsize=fontsize)
                axs[i].set_ylabel("Input batch", fontsize=fontsize)
                axs[i].set_title(
                    f"Weights across protein sequence in batch (Layer {i + 1})",
                    fontsize=fontsize,
                )
                axs[i].tick_params(axis="x", labelsize=10.5)
            plt.show()


